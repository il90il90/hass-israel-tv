{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant (remote attach)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "homeassistant.local",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/custom_components",
          "remoteRoot": "/config/custom_components"
        }
      ],
      "justMyCode": false
    }
  ]
}
